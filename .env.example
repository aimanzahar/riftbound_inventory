# Copy to .env to override defaults (all optional)
PORT=8787
HOST=0.0.0.0
DATA_DIR=./data
# Set to 1 to disable the in-process job scheduler (tests / CLI-only setups)
NO_SCHEDULER=
# Model passed to `codex exec -m` when generating tips (empty = codex default)
CODEX_MODEL=
# Source adapters: riot|localjson, tcgcsv|dotgg|localjson, riftools|boundrift|localjson
CARD_SOURCE=riot
PRICE_SOURCE=tcgcsv
META_SOURCE=riftools
